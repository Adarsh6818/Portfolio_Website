# Contact form email delivery (Resend — https://resend.com)
# Without RESEND_API_KEY the form runs in "dev mode": it validates and logs
# the submission to the server console and returns success (no email sent).

# Your Resend API key (create one at https://resend.com/api-keys)
RESEND_API_KEY=

# Where contact-form messages are delivered. Defaults to siteConfig.email.
CONTACT_TO_EMAIL=

# The "from" address. For quick testing you can use the Resend sandbox sender:
#   Portfolio <onboarding@resend.dev>
# For production, verify your own domain in Resend and use an address on it.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
